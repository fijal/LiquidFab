namespace LiquidFab.Savegame;

struct Tree {
    x:int;
    y:int;
    kind:int;
    age:float;
}

struct WaterPump {
	x:int;
	y:int;
	fuel_level: float;
	logs: int;
}

table Savegame {
    version: int;
    trees: [Tree];
	water_pumps: [WaterPump];
	terrain_level: [float];
	terrain_kind: [float];
	water_level: [float];
	water_flow_x: [float];
	water_flow_y: [float];
	sub_water_level: [float];
	sub_flow_x: [float];
	sub_flow_y: [float];
}
